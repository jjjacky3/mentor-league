<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ league_name }} — Standings & Leaderboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              500: '#22c55e',
              600: '#16a34a',
            }
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .tab-btn.active {
      background-color: #334155;
      color: #38bdf8;
      border-color: #38bdf8;
    }
  </style>
</head>
<body class="min-h-full flex flex-col bg-slate-950 text-slate-100 antialiased selection:bg-cyan-500 selection:text-white">

  <!-- Top Navigation / Header -->
  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-emerald-400 flex items-center justify-center font-black text-slate-950 text-xl shadow-lg shadow-cyan-500/20">
          🏈
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white flex items-center gap-2">
            {{ league_name }}
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
              Season {{ season }}
            </span>
          </h1>
          <p class="text-xs sm:text-sm text-slate-400">10 Teams · 5 Mentor/Mentee Pairs · Combined Pair Scoring</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="text-right hidden sm:block">
          <div class="text-xs text-slate-400 font-medium">League Status</div>
          {% if is_preseason %}
            <div class="text-sm font-bold text-amber-400">Week 1 Upcoming</div>
          {% else %}
            <div class="text-sm font-bold text-emerald-400">Week {{ current_week }} Completed</div>
          {% endif %}
        </div>
        <a href="standings.csv" download class="inline-flex items-center px-3.5 py-2 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          <svg class="w-4 h-4 mr-1.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Export CSV
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

    <!-- Rules Alert Banner -->
    <div class="rounded-2xl border border-cyan-500/20 bg-gradient-to-r from-cyan-950/40 via-slate-900/60 to-slate-900/40 p-4 sm:p-5 shadow-xl backdrop-blur">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-start space-x-3">
          <div class="text-xl">⚡</div>
          <div>
            <h2 class="text-sm font-bold text-cyan-300 uppercase tracking-wider">Official Pair Scoring Rules</h2>
            <p class="text-xs sm:text-sm text-slate-300 mt-0.5 leading-relaxed">
              Pairs combine individual weekly results (2-0, 1-1, or 0-2).
              <span class="text-amber-300 font-semibold">Upset Bonus:</span> If a Beginner defeats an Expert, that win counts as <span class="text-amber-300 font-bold underline">1.5 wins</span>!
              Tiebreaker is Total Combined Points For. Top 4 pairs qualify for playoffs.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="border-b border-slate-800">
      <nav class="flex space-x-2 sm:space-x-4 overflow-x-auto pb-2 scrollbar-none" id="dashboard-tabs">
        <button onclick="switchTab('tab-standings')" id="btn-tab-standings" class="tab-btn active px-4 py-2 text-sm font-semibold rounded-lg border border-transparent transition">
          🏆 Pair Standings
        </button>
        <button onclick="switchTab('tab-mentee')" id="btn-tab-mentee" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition">
          ⭐ Mentee Performance
        </button>
        <button onclick="switchTab('tab-peers')" id="btn-tab-peers" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition">
          👥 Peer Leaderboards
        </button>
        <button onclick="switchTab('tab-playoffs')" id="btn-tab-playoffs" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition">
          🛡️ Playoff Bracket
        </button>
        <button onclick="switchTab('tab-weekly')" id="btn-tab-weekly" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg text-slate-400 hover:text-slate-200 border border-transparent transition">
          📅 Weekly Results & Awards
        </button>
      </nav>
    </div>

    <!-- TAB 1: OFFICIAL PAIR STANDINGS -->
    <section id="tab-standings" class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <h2 class="text-xl font-bold text-white tracking-tight">Official Pair Standings</h2>
          <p class="text-xs sm:text-sm text-slate-400">Ranked by combined wins (including Upset Bonuses) → Total Points-For tiebreaker</p>
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 shadow-2xl">
        <table class="min-w-full divide-y divide-slate-800 text-left text-sm">
          <thead class="bg-slate-950/60 text-xs uppercase font-bold text-slate-400 tracking-wider">
            <tr>
              <th scope="col" class="py-4 px-4 w-16 text-center">Rank</th>
              <th scope="col" class="py-4 px-4">Pair & Teammates</th>
              <th scope="col" class="py-4 px-4 text-center">Record (W-L-T)</th>
              <th scope="col" class="py-4 px-4 text-center">Win %</th>
              <th scope="col" class="py-4 px-4 text-right">Points For</th>
              <th scope="col" class="py-4 px-4 text-right">Points Against</th>
              <th scope="col" class="py-4 px-4 text-right">Avg Pts</th>
              <th scope="col" class="py-4 px-4 text-center">Upsets</th>
              <th scope="col" class="py-4 px-4 text-center">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {% for pair in pair_standings %}
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-4 px-4 text-center font-bold">
                {% if pair.rank == 1 %}
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-400/10 text-amber-400 border border-amber-400/30 font-black">1</span>
                {% elif pair.rank == 2 %}
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-slate-300/10 text-slate-300 border border-slate-300/30 font-black">2</span>
                {% elif pair.rank == 3 %}
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-700/10 text-amber-600 border border-amber-700/30 font-black">3</span>
                {% else %}
                  <span class="text-slate-500">{{ pair.rank }}</span>
                {% endif %}
              </td>
              <td class="py-4 px-4">
                <div class="font-bold text-white text-base">{{ pair.pair_name }}</div>
                <div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-slate-400">
                  <span class="inline-flex items-center px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
                    🐣 {{ pair.beginner_name }} (Beginner)
                  </span>
                  <span class="text-slate-600">+</span>
                  <span class="inline-flex items-center px-2 py-0.5 rounded bg-blue-500/10 text-blue-300 border border-blue-500/20">
                    🧙 {{ pair.expert_name }} (Mentor)
                  </span>
                </div>
              </td>
              <td class="py-4 px-4 text-center">
                <span class="font-extrabold text-base text-emerald-400">{{ pair.wins }}</span>
                <span class="text-slate-500">-</span>
                <span class="font-bold text-slate-300">{{ pair.losses }}</span>
                {% if pair.ties > 0 %}
                <span class="text-slate-500">-</span>
                <span class="text-slate-400">{{ pair.ties }}</span>
                {% endif %}
              </td>
              <td class="py-4 px-4 text-center font-mono font-medium text-slate-300">
                {{ "%.3f"|format(pair.win_pct) }}
              </td>
              <td class="py-4 px-4 text-right font-mono font-bold text-cyan-400">
                {{ "%.2f"|format(pair.points_for) }}
              </td>
              <td class="py-4 px-4 text-right font-mono text-slate-400">
                {{ "%.2f"|format(pair.points_against) }}
              </td>
              <td class="py-4 px-4 text-right font-mono text-slate-300">
                {{ "%.2f"|format(pair.avg_points) }}
              </td>
              <td class="py-4 px-4 text-center">
                {% if pair.upsets_total > 0 %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                    ⚡ {{ pair.upsets_total }}
                  </span>
                {% else %}
                  <span class="text-slate-600 text-xs">0</span>
                {% endif %}
              </td>
              <td class="py-4 px-4 text-center">
                {% if pair.is_playoff_seed %}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    Seed #{{ pair.seed }}
                  </span>
                {% else %}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">
                    Eliminated
                  </span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TAB 2: MENTEE PERFORMANCE LEADERBOARD -->
    <section id="tab-mentee" class="space-y-6 hidden">
      <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Top Mentee Performance Leaderboard</h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Ranked by Weighted Score: <code class="text-cyan-300 bg-slate-800 px-1.5 py-0.5 rounded">0.70 × Beginner + 0.30 × Mentor</code>
          celebrating strong mentee scoring impact!
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for pair in mentee_standings %}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 space-y-4 hover:border-cyan-500/40 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold px-2.5 py-1 rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
              #{{ loop.index }} Mentee Rank
            </span>
            <span class="text-xs font-medium text-slate-400">Pair Standings #{{ pair.rank }}</span>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">{{ pair.pair_name }}</h3>
            <p class="text-xs text-slate-400">Mentee: <strong class="text-emerald-300">{{ pair.beginner_name }}</strong></p>
          </div>
          <div class="bg-slate-950/60 rounded-xl p-3 border border-slate-800/80 flex items-center justify-between">
            <div>
              <div class="text-xs text-slate-400">Total Weighted Pts</div>
              <div class="text-2xl font-black text-cyan-400">{{ "%.2f"|format(pair.weighted_score_total) }}</div>
            </div>
            <div class="text-right">
              <div class="text-xs text-slate-400">Weekly Avg</div>
              <div class="text-sm font-bold text-slate-200">{{ "%.2f"|format(pair.avg_weighted_score) }}</div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- TAB 3: PEER LEADERBOARDS -->
    <section id="tab-peers" class="space-y-8 hidden">
      <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Individual Peer Leaderboards</h2>
        <p class="text-xs sm:text-sm text-slate-400">Direct head-to-head comparison among peers (pure individual W/L and points, no upset bonuses applied).</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Beginner Leaderboard -->
        <div class="space-y-4">
          <div class="flex items-center space-x-2">
            <span class="text-lg">🐣</span>
            <h3 class="text-lg font-bold text-emerald-400">Beginners (Mentees) Leaderboard</h3>
          </div>
          <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 shadow">
            <table class="min-w-full divide-y divide-slate-800 text-left text-sm">
              <thead class="bg-slate-950/60 text-xs uppercase font-bold text-slate-400">
                <tr>
                  <th class="py-3 px-3 text-center">Rank</th>
                  <th class="py-3 px-3">Manager</th>
                  <th class="py-3 px-3 text-center">Record</th>
                  <th class="py-3 px-3 text-right">Points</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/50">
                {% for b in beginner_leaderboard %}
                <tr class="hover:bg-slate-800/30">
                  <td class="py-3 px-3 text-center font-bold text-slate-300">{{ b.rank }}</td>
                  <td class="py-3 px-3">
                    <div class="font-semibold text-white">{{ b.name }}</div>
                    <div class="text-xs text-slate-400">{{ b.team_name }}</div>
                  </td>
                  <td class="py-3 px-3 text-center font-mono">
                    <span class="text-emerald-400 font-bold">{{ b.wins|int }}</span> - {{ b.losses|int }}
                  </td>
                  <td class="py-3 px-3 text-right font-mono font-bold text-cyan-400">
                    {{ "%.2f"|format(b.points_for) }}
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Mentor Leaderboard -->
        <div class="space-y-4">
          <div class="flex items-center space-x-2">
            <span class="text-lg">🧙</span>
            <h3 class="text-lg font-bold text-blue-400">Mentors (Experts) Leaderboard</h3>
          </div>
          <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900/60 shadow">
            <table class="min-w-full divide-y divide-slate-800 text-left text-sm">
              <thead class="bg-slate-950/60 text-xs uppercase font-bold text-slate-400">
                <tr>
                  <th class="py-3 px-3 text-center">Rank</th>
                  <th class="py-3 px-3">Manager</th>
                  <th class="py-3 px-3 text-center">Record</th>
                  <th class="py-3 px-3 text-right">Points</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/50">
                {% for m in mentor_leaderboard %}
                <tr class="hover:bg-slate-800/30">
                  <td class="py-3 px-3 text-center font-bold text-slate-300">{{ m.rank }}</td>
                  <td class="py-3 px-3">
                    <div class="font-semibold text-white">{{ m.name }}</div>
                    <div class="text-xs text-slate-400">{{ m.team_name }}</div>
                  </td>
                  <td class="py-3 px-3 text-center font-mono">
                    <span class="text-blue-400 font-bold">{{ m.wins|int }}</span> - {{ m.losses|int }}
                  </td>
                  <td class="py-3 px-3 text-right font-mono font-bold text-cyan-400">
                    {{ "%.2f"|format(m.points_for) }}
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 4: PLAYOFF BRACKET -->
    <section id="tab-playoffs" class="space-y-6 hidden">
      <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Playoffs: The Mentor Cup</h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Top 4 pairs qualify for a 2-round virtual head-to-head bracket. Winner decided by total combined points that week.
        </p>
      </div>

      {% if playoffs_preview %}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Semifinal 1 -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Semifinal 1</span>
            <span class="text-xs text-slate-400">Playoff Week 1</span>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/70 border border-slate-800">
              <div>
                <span class="text-xs font-bold text-emerald-400 mr-2">#1 SEED</span>
                <span class="font-bold text-white">{{ playoffs_preview.semifinal_1.seed_high.pair_name }}</span>
                <div class="text-xs text-slate-400">{{ playoffs_preview.semifinal_1.seed_high.wins }}-{{ playoffs_preview.semifinal_1.seed_high.losses }} · {{ playoffs_preview.semifinal_1.seed_high.points_for }} pts</div>
              </div>
            </div>
            <div class="text-center text-xs font-black text-slate-500">VS</div>
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/70 border border-slate-800">
              <div>
                <span class="text-xs font-bold text-cyan-400 mr-2">#4 SEED</span>
                <span class="font-bold text-white">{{ playoffs_preview.semifinal_1.seed_low.pair_name }}</span>
                <div class="text-xs text-slate-400">{{ playoffs_preview.semifinal_1.seed_low.wins }}-{{ playoffs_preview.semifinal_1.seed_low.losses }} · {{ playoffs_preview.semifinal_1.seed_low.points_for }} pts</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Semifinal 2 -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Semifinal 2</span>
            <span class="text-xs text-slate-400">Playoff Week 1</span>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/70 border border-slate-800">
              <div>
                <span class="text-xs font-bold text-emerald-400 mr-2">#2 SEED</span>
                <span class="font-bold text-white">{{ playoffs_preview.semifinal_2.seed_high.pair_name }}</span>
                <div class="text-xs text-slate-400">{{ playoffs_preview.semifinal_2.seed_high.wins }}-{{ playoffs_preview.semifinal_2.seed_high.losses }} · {{ playoffs_preview.semifinal_2.seed_high.points_for }} pts</div>
              </div>
            </div>
            <div class="text-center text-xs font-black text-slate-500">VS</div>
            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-950/70 border border-slate-800">
              <div>
                <span class="text-xs font-bold text-cyan-400 mr-2">#3 SEED</span>
                <span class="font-bold text-white">{{ playoffs_preview.semifinal_2.seed_low.pair_name }}</span>
                <div class="text-xs text-slate-400">{{ playoffs_preview.semifinal_2.seed_low.wins }}-{{ playoffs_preview.semifinal_2.seed_low.losses }} · {{ playoffs_preview.semifinal_2.seed_low.points_for }} pts</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {% endif %}
    </section>

    <!-- TAB 5: WEEKLY RESULTS & AWARDS -->
    <section id="tab-weekly" class="space-y-8 hidden">
      {% for week in weekly_snapshots|reverse %}
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <h3 class="text-xl font-black text-white">Week {{ week.week }} {% if week.is_unplayed %}Upcoming Schedule{% else %}Recap{% endif %}</h3>
          <span class="text-xs font-semibold px-3 py-1 rounded-full {% if week.is_unplayed %}bg-amber-500/10 text-amber-400 border border-amber-500/20{% else %}bg-slate-800 text-slate-300 border border-slate-700{% endif %}">
            {% if week.is_unplayed %}Scheduled (Kickoff Pending){% else %}Final Scores{% endif %}
          </span>
        </div>

        {% if week.is_unplayed %}
        <!-- Scheduled Individual Matchups -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Scheduled Individual Matchups</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for game in week.matchup_games %}
            <div class="rounded-xl bg-slate-950/70 border border-slate-800/90 p-4 flex items-center justify-between">
              <div class="space-y-0.5">
                <div class="font-bold text-white text-sm">{{ game.team1.name }}</div>
                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold {% if game.team1.role == 'beginner' %}bg-emerald-500/10 text-emerald-300 border border-emerald-500/20{% else %}bg-blue-500/10 text-blue-300 border border-blue-500/20{% endif %}">
                  {{ game.team1.role|capitalize }}
                </span>
              </div>
              <div class="text-center px-3">
                <span class="text-xs font-black text-slate-500">VS</span>
              </div>
              <div class="space-y-0.5 text-right">
                <div class="font-bold text-white text-sm">{{ game.team2.name }}</div>
                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold {% if game.team2.role == 'beginner' %}bg-emerald-500/10 text-emerald-300 border border-emerald-500/20{% else %}bg-blue-500/10 text-blue-300 border border-blue-500/20{% endif %}">
                  {{ game.team2.role|capitalize }}
                </span>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <!-- Weekly Awards Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Highest Combined -->
          <div class="rounded-xl bg-slate-950/70 border border-emerald-500/20 p-4 space-y-1">
            <div class="text-xs font-bold uppercase text-emerald-400">🔥 {{ week.awards.highest_combined_score.title }}</div>
            <div class="text-sm font-bold text-white truncate">{{ week.awards.highest_combined_score.winner }}</div>
            <div class="text-xs text-slate-400">{{ week.awards.highest_combined_score.score }} combined pts</div>
          </div>
          <!-- Best Upset -->
          <div class="rounded-xl bg-slate-950/70 border border-amber-500/20 p-4 space-y-1">
            <div class="text-xs font-bold uppercase text-amber-400">⚡ {{ week.awards.best_upset.title }}</div>
            <div class="text-sm font-bold text-white truncate">{{ week.awards.best_upset.winner }}</div>
            <div class="text-xs text-slate-400">{{ week.awards.best_upset.detail }}</div>
          </div>
          <!-- Biggest Blowout -->
          <div class="rounded-xl bg-slate-950/70 border border-purple-500/20 p-4 space-y-1">
            <div class="text-xs font-bold uppercase text-purple-400">💥 {{ week.awards.biggest_blowout.title }}</div>
            <div class="text-sm font-bold text-white truncate">{{ week.awards.biggest_blowout.winner }}</div>
            <div class="text-xs text-slate-400">{{ week.awards.biggest_blowout.detail }}</div>
          </div>
          <!-- Closest Match -->
          <div class="rounded-xl bg-slate-950/70 border border-cyan-500/20 p-4 space-y-1">
            <div class="text-xs font-bold uppercase text-cyan-400">🎯 {{ week.awards.closest_match.title }}</div>
            <div class="text-sm font-bold text-white truncate">{{ week.awards.closest_match.winner }}</div>
            <div class="text-xs text-slate-400">{{ week.awards.closest_match.detail }}</div>
          </div>
        </div>

        <!-- Weekly Pair Breakdown Table -->
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/40">
          <table class="min-w-full divide-y divide-slate-800 text-left text-xs sm:text-sm">
            <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
              <tr>
                <th class="py-3 px-4">Pair</th>
                <th class="py-3 px-4">Beginner Score</th>
                <th class="py-3 px-4">Mentor Score</th>
                <th class="py-3 px-4 text-right">Combined Pts</th>
                <th class="py-3 px-4 text-center">Week Result</th>
                <th class="py-3 px-4 text-right">Weighted Score</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {% for p in week.pair_results %}
              <tr class="hover:bg-slate-800/30">
                <td class="py-3 px-4 font-bold text-white">{{ p.pair_name }}</td>
                <td class="py-3 px-4">
                  <span class="text-slate-300">{{ p.beginner_name }}:</span>
                  <strong class="text-emerald-400 ml-1 font-mono">{{ p.beginner_points }}</strong>
                  {% if p.beginner_upset %}
                    <span class="ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-black bg-amber-400/20 text-amber-300 border border-amber-400/30">
                      ⚡ UPSET (+1.5w)
                    </span>
                  {% endif %}
                </td>
                <td class="py-3 px-4">
                  <span class="text-slate-300">{{ p.expert_name }}:</span>
                  <strong class="text-blue-400 ml-1 font-mono">{{ p.expert_points }}</strong>
                </td>
                <td class="py-3 px-4 text-right font-mono font-bold text-cyan-300">
                  {{ p.combined_points }}
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  <span class="text-emerald-400">{{ p.wins }}W</span> - <span class="text-slate-400">{{ p.losses }}L</span>
                </td>
                <td class="py-3 px-4 text-right font-mono font-semibold text-slate-300">
                  {{ p.weighted_score }}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800/80 bg-slate-950 py-6 text-center text-xs text-slate-500">
    <p>Fantasy Football Mentor League Overlay App · Powered by Sleeper API</p>
  </footer>

  <script>
    function switchTab(targetId) {
      // Hide all tabs
      const tabs = ['tab-standings', 'tab-mentee', 'tab-peers', 'tab-playoffs', 'tab-weekly'];
      tabs.forEach(id => {
        const el = document.getElementById(id);
        const btn = document.getElementById('btn-' + id);
        if (el) el.classList.add('hidden');
        if (btn) {
          btn.classList.remove('active', 'bg-slate-800', 'text-cyan-400', 'border-cyan-400');
          btn.classList.add('text-slate-400');
        }
      });

      // Show selected tab
      const activeEl = document.getElementById(targetId);
      const activeBtn = document.getElementById('btn-' + targetId);
      if (activeEl) activeEl.classList.remove('hidden');
      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-slate-800', 'text-cyan-400', 'border-cyan-400');
        activeBtn.classList.remove('text-slate-400');
      }
    }
  </script>
</body>
</html>

